{
  "manifest_version": 3,
  "name": "NoteOn - Captura de Slides e Telas da Aula",
  "version": "1.0.0",
  "description": "Tira print da aula (Meet, Zoom, Slides, YouTube) e salva automaticamente no NoteOn sincronizado com o áudio gravado.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NoteOn - Capturar Slide da Aula (Alt+S)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.vercel.app/*",
        "https://*.noteon.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "capture-slide": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Tirar print da aba ativa e salvar no NoteOn"
    }
  }
}
