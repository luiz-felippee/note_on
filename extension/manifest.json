{
  "manifest_version": 3,
  "name": "NoteOn - Captura e Recorte de Slides",
  "version": "1.1.0",
  "description": "Marque a área do slide ou tire print da aula (Meet, Zoom, Slides, YouTube, PDF) e salve automaticamente no NoteOn sincronizado com o áudio gravado.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NoteOn - Marcar Área ou Print (Alt+S)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.vercel.app/*",
        "https://*.noteon.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "capture-area": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Marcar área da tela (recorte) e salvar no NoteOn"
    },
    "capture-full": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Tirar print da tela inteira e salvar no NoteOn"
    }
  }
}
